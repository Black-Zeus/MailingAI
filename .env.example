# =============================================================================
# n8n
# =============================================================================

# Imagen de n8n a usar.
# Mantener siempre una version concreta, no usar latest.
# 2.21.7 tiene un issue reportado con validaciones -> se usa 2.31.1.
N8N_VERSION=2.31.1

# Puerto publicado en el host para entrar a n8n.
# Distinto al de TC_N8N (80/5678) para poder correr ambos stacks a la vez.
N8N_PORT=5680

# Host publico usado por n8n para generar URLs internas y webhooks.
N8N_HOST=localhost

# URL publica base para webhooks.
# Debe coincidir con el puerto/host por donde accedes desde fuera de Docker.
WEBHOOK_URL=http://localhost/n8n/

# URL publica del editor de n8n.
N8N_EDITOR_BASE_URL=http://localhost/n8n/
N8N_PATH=/n8n/

# Rutas permitidas para nodos de lectura/escritura de archivos.
# /files corresponde a la carpeta local ./share montada en el contenedor.
N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n-files;/files

# =============================================================================
# Zona horaria
# =============================================================================

# Zona horaria del stack.
TZ=America/Santiago

# Zona horaria usada por n8n para planificaciones y fechas.
GENERIC_TIMEZONE=America/Santiago

# =============================================================================
# PostgreSQL
# =============================================================================

# Puerto publicado en el host para conectarse a Postgres desde tu maquina.
# Dentro de Docker, n8n usa postgres:5432.
POSTGRES_PORT=5433

# Base de datos usada por n8n y por el esquema mailing.
POSTGRES_DB=mailingai

# Usuario de Postgres.
POSTGRES_USER=mailingai

# Password de Postgres. Genera uno propio, no dejes el de ejemplo.
POSTGRES_PASSWORD=CAMBIA_ESTE_PASSWORD

# =============================================================================
# Backend FastAPI (generador de graficos)
# =============================================================================

# Puerto publicado para el backend local.
# Dentro de Docker, n8n usa http://backend:8000.
BACKEND_PORT=8001

# Version/tag local de la imagen del backend. Mantener version concreta.
BACKEND_VERSION=0.1.0

# Nombre logico expuesto por el endpoint de salud.
BACKEND_APP_NAME=mailingai-backend

# =============================================================================
# Frontend (React + TypeScript + Vite, servido por nginx)
# =============================================================================

# Puerto publicado para el frontend local.
FRONTEND_PORT=5173

# Version/tag local de la imagen del frontend. Mantener version concreta.
FRONTEND_VERSION=0.1.0

# URL publica del backend que el frontend usa para llamar a la API.
# Se hornea en el build de Vite (import.meta.env.VITE_API_URL): cambiarla
# requiere reconstruir la imagen (docker compose build frontend).
FRONTEND_API_URL=http://localhost

# Origenes permitidos por CORS en el backend (separados por coma si son varios).
# Debe incluir el origen real desde el que el navegador abre el frontend.
FRONTEND_ORIGINS=http://localhost

# =============================================================================
# Webhook interno FastAPI -> n8n (Fase 3)
# =============================================================================

# Secreto compartido para llamadas server-to-server dentro del stack:
# - backend dispara workflows en n8n con esto (webhooks, ej. "07 - Execute
#   Analysis Job"); n8n lo valida via la credencial "MailingAI Webhook Secret"
#   (httpHeaderAuth).
# - Tambien protege las rutas /internal/* del backend y de identity-broker
#   (backend<->identity-broker, y n8n->backend para notificaciones) --
#   ver docs/SECURITY.md.
# Generado con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si lo regeneras, actualiza tambien n8n/credentials/mailingai-webhook-secret.json
# y reimporta (./scripts/import-n8n.sh).
WEBHOOK_SHARED_SECRET=CAMBIA_ESTE_SECRETO

# Nombre del header HTTP que transporta el secreto de arriba.
WEBHOOK_SHARED_SECRET_HEADER=X-MailingAI-Secret

# URL interna del webhook de n8n que el backend llama al crear un job.
N8N_WEBHOOK_INTERNAL_URL=http://n8n:5678/webhook/execute-analysis-job

# URL interna del webhook de n8n que el backend llama para descargar el
# contenido real de un adjunto (workflow 08). A diferencia del de arriba,
# este es sincrono: el backend espera la respuesta con el archivo.
N8N_WEBHOOK_DOWNLOAD_URL=http://n8n:5678/webhook/download-attachment
N8N_WEBHOOK_RETRACE_URL=http://n8n:5678/webhook/retrace-attachments

# URL interna del webhook de n8n que fuerza a mano la sincronizacion delta de
# buzones (workflow 15) -- normalmente corre sola una vez al dia por
# Schedule Trigger, esto la dispara al toque desde el boton de Configuracion.
N8N_WEBHOOK_MAILBOX_DELTA_SYNC_URL=http://n8n:5678/webhook/mailbox-delta-sync

# =============================================================================
# Microsoft Graph (buzon real) - identity-broker
# =============================================================================
#
# Desde la migracion 20260723_0001, las credenciales OAuth2 (tenant id,
# client id, client secret) las usa el servicio identity-broker, NO n8n --
# n8n pide un token vigente al broker en vez de tener su propia credencial.
# Es el mismo app registration de Azure AD que antes se cargaba en la UI de
# n8n (ver docs/AZURE_SETUP.md).
#
# Tenant/client id no son secretos por si solos, pero el client secret si --
# nunca los commitees con valores reales.
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=CAMBIA_ESTE_CLIENT_SECRET

# Puerto publicado en el host para el identity-broker (flujo OAuth2 real,
# el navegador navega ahi para conectar una cuenta nueva).
IDENTITY_BROKER_PORT=8002

# Version/tag local de la imagen del identity-broker.
IDENTITY_BROKER_VERSION=0.1.0

# URL publica (alcanzable desde el navegador) del identity-broker. Debe
# coincidir EXACTO con un "Redirect URI" registrado en la app de Azure AD
# (Authentication > Web > Redirect URIs): agregar
# http://localhost:8002/oauth/microsoft/callback ahi a mano -- no hay forma
# de hacerlo via API con los permisos delegados que ya tiene esta app.
IDENTITY_BROKER_PUBLIC_URL=http://localhost/identity

# URL interna (red de Docker) que el backend usa para llamar al broker.
IDENTITY_BROKER_URL=http://identity-broker:8000

# =============================================================================
# Login de usuarios (SSO Microsoft/Entra ID) - backend
# =============================================================================
#
# Reutiliza MS_TENANT_ID/MS_CLIENT_ID/MS_CLIENT_SECRET de arriba (mismo app
# registration que identity-broker) -- agregar aca solo un segundo Redirect
# URI en el portal de Azure AD:
# http://localhost:8001/api/auth/microsoft/callback

# URL publica de este backend (redirect_uri del login) y del frontend (adonde
# se redirige al terminar el login).
BACKEND_PUBLIC_URL=http://localhost
FRONTEND_URL=http://localhost

# Atributo Secure de la cookie de sesion. false en dev local (http://localhost),
# DEBE ser true en produccion detras de TLS.
SESSION_COOKIE_SECURE=false

# =============================================================================
# AI Gateway - proveedores de IA intercambiables
# =============================================================================

# La lista de proveedores (Ollama/OpenAI/Anthropic), cual esta activo, y la
# politica (local_only / allow_external) ya no se configuran aca -- se
# administran desde la UI (Configuracion) y quedan guardadas en Postgres
# (mailing.ai_providers / mailing.ai_settings). Al crear el volumen por
# primera vez se agrega automaticamente un Ollama local activo por defecto.

# Puerto publicado en el host para Ollama (11435, no el 11434 default, por si
# ya tenes un Ollama nativo corriendo en la maquina). Dentro de Docker, el
# backend usa http://ollama:11434.
OLLAMA_PORT=11435

# Unico puerto publicado al host -- todo lo demas (postgres/backend/
# identity-broker/frontend/n8n/ollama) ya no publica puerto propio, solo
# se alcanza via la red interna de docker. Ver proxy/nginx.conf.
PROXY_PORT=80
