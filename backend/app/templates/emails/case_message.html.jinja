<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <title>{{ subject }}</title>
  <style>
    .msg-content p { margin: 0 0 14px; }
    .msg-content p:last-child { margin-bottom: 0; }
    .msg-content ul, .msg-content ol { margin: 0 0 14px; padding-left: 22px; }
    .msg-content li { margin-bottom: 4px; }
    .msg-content h1, .msg-content h2, .msg-content h3,
    .msg-content h4, .msg-content h5, .msg-content h6 { margin: 0 0 10px; color: #10243d; }
    .msg-content blockquote { margin: 0 0 14px; padding-left: 12px; border-left: 3px solid #dbe3ea; color: #55636f; }
    .msg-content code { font-family: ui-monospace, Consolas, monospace; background: #f0f3f6; padding: 2px 5px; border-radius: 4px; font-size: 13px; }
    .msg-content pre { margin: 0 0 14px; padding: 12px 14px; background: #f0f3f6; border-radius: 8px; overflow-x: auto; }
    .msg-content pre code { background: none; padding: 0; }
    .msg-content table { border-collapse: collapse; width: 100%; margin: 0 0 14px; }
    .msg-content th, .msg-content td { border: 1px solid #dbe3ea; padding: 6px 10px; text-align: left; font-size: 14px; }
    .msg-content a { color: #1f648f; }
    .msg-content hr { border: 0; border-top: 1px solid #dbe3ea; margin: 16px 0; }
  </style>
</head>
<body style="margin:0;padding:0;background:#eef2f6;font-family:Arial,'Helvetica Neue',sans-serif;color:#182432;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#eef2f6;">
    <tr><td align="center" style="padding:32px 12px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px;background:#ffffff;border:1px solid #dbe3ea;border-radius:12px;overflow:hidden;">
        <tr><td style="height:7px;background:#10243d;font-size:0;line-height:0;">&nbsp;</td></tr>
        <tr><td style="padding:28px 40px 18px;">
          <table role="presentation" width="100%"><tr>
            <td style="font-size:21px;font-weight:700;color:#10243d;">Mailing<span style="color:#299d9d;">AI</span></td>
            <td align="right" style="font-size:12px;color:#687787;">Mensaje sobre un expediente</td>
          </tr></table>
        </td></tr>
        <tr><td style="padding:10px 40px 0;">
          <h1 style="margin:8px 0 16px;font-size:22px;line-height:29px;color:#10243d;">{{ subject }}</h1>
        </td></tr>
        <tr><td style="padding:0 40px 8px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f5f8fa;border:1px solid #dce5eb;border-radius:8px;">
            <tr><td style="padding:14px 18px;font-size:13px;line-height:20px;color:#455565;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                <tr>
                  <td style="font-size:12px;color:#71808f;">EXPEDIENTE</td>
                  <td align="right"><span style="padding:4px 9px;border-radius:16px;background:#fff1d8;color:#9b5c00;font-size:11px;font-weight:700;">{{ case_status }}</span></td>
                </tr>
              </table>
              <div style="margin:5px 0 0;font-size:16px;font-weight:700;color:#10243d;">{{ case_title }}{% if external_code %} <span style="font-weight:400;color:#687787;">({{ external_code }})</span>{% endif %}</div>
            </td></tr>
          </table>
        </td></tr>
        <tr><td style="padding:22px 40px 8px;font-size:15px;line-height:24px;color:#2b3947;" class="msg-content">
          {{ body_html | safe }}
        </td></tr>
        <tr><td style="padding:18px 40px;background:#f7f9fb;border-top:1px solid #e1e7ec;font-size:12px;line-height:19px;color:#71808f;">
          Enviado por {{ sent_by }} desde MailingAI, en relación al expediente "{{ case_title }}".<br><br>
          © {{ current_year }} MailingAI
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
