<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <title>Nuevo acceso a un buzón en MailingAI</title>
</head>
<body style="margin:0;padding:0;background:#eef2f6;font-family:Arial,'Helvetica Neue',sans-serif;color:#182432;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{ granted_by }} te otorgó acceso de solo lectura al buzón {{ mailbox_name }}.</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#eef2f6;">
    <tr><td align="center" style="padding:32px 12px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px;background:#ffffff;border:1px solid #dbe3ea;border-radius:12px;overflow:hidden;">
        <tr><td style="height:7px;background:#10243d;font-size:0;line-height:0;">&nbsp;</td></tr>
        <tr><td style="padding:28px 40px 18px;">
          <table role="presentation" width="100%"><tr>
            <td style="font-size:21px;font-weight:700;color:#10243d;">Mailing<span style="color:#299d9d;">AI</span></td>
            <td align="right" style="font-size:12px;color:#687787;">Notificación de acceso</td>
          </tr></table>
        </td></tr>
        <tr><td style="padding:10px 40px 0;">
          <div style="display:inline-block;padding:6px 10px;border-radius:20px;background:#eaf2f9;color:#1f648f;font-size:12px;font-weight:700;">ACCESO A BUZÓN</div>
          <h1 style="margin:18px 0 10px;font-size:27px;line-height:34px;color:#10243d;">Tienes acceso a un nuevo buzón</h1>
          <p style="margin:0 0 20px;font-size:16px;line-height:25px;color:#455565;"><strong>{{ granted_by }}</strong> te otorgó acceso al buzón <strong>{{ mailbox_name }}</strong>.</p>
        </td></tr>
        <tr><td style="padding:0 40px 8px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f5f8fa;border:1px solid #dce5eb;border-radius:8px;">
            <tr><td style="padding:18px 20px;font-size:14px;line-height:22px;color:#455565;">
              <strong style="color:#10243d;">Buzón</strong><br>{{ mailbox_name }} &lt;{{ mailbox_address }}&gt;<br><br>
              <strong style="color:#10243d;">Nivel de acceso</strong><br>Solo lectura<br><br>
              <strong style="color:#10243d;">Otorgado</strong><br>{{ granted_at }}
            </td></tr>
          </table>
        </td></tr>
        <tr><td align="center" style="padding:22px 40px 12px;">
          <table role="presentation" cellspacing="0" cellpadding="0"><tr><td bgcolor="#1f648f" style="border-radius:7px;">
            <a href="{{ app_url }}" style="display:inline-block;padding:14px 27px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:700;">Abrir MailingAI</a>
          </td></tr></table>
        </td></tr>
        <tr><td style="padding:10px 40px 26px;font-size:13px;line-height:20px;color:#687787;">
          Este permiso te deja ver los correos indexados de este buzón desde los expedientes donde aparezcan. No compartas esa información fuera de los canales autorizados.
        </td></tr>
        <tr><td style="padding:18px 40px;background:#fff7e8;border-top:1px solid #f0d7a4;font-size:13px;line-height:20px;color:#6e531a;">
          <strong>¿No reconoces este acceso?</strong><br>Contacta a tu administrador.
        </td></tr>
        <tr><td style="padding:18px 40px;background:#f7f9fb;border-top:1px solid #e1e7ec;font-size:12px;line-height:19px;color:#71808f;">
          Mensaje automático. No respondas a este correo.<br>
          © {{ current_year }} MailingAI
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
