<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <title>Tu cuenta en MailingAI está lista</title>
</head>
<body style="margin:0;padding:0;background:#eef2f6;font-family:Arial,'Helvetica Neue',sans-serif;color:#182432;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">Tu cuenta en MailingAI está lista.</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#eef2f6;">
    <tr><td align="center" style="padding:32px 12px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px;background:#ffffff;border:1px solid #dbe3ea;border-radius:12px;overflow:hidden;">
        <tr><td style="height:7px;background:#10243d;font-size:0;line-height:0;">&nbsp;</td></tr>
        <tr><td style="padding:28px 40px 18px;">
          <table role="presentation" width="100%"><tr>
            <td style="font-size:21px;font-weight:700;color:#10243d;">Mailing<span style="color:#299d9d;">AI</span></td>
            <td align="right" style="font-size:12px;color:#687787;">Gestión de expedientes</td>
          </tr></table>
        </td></tr>
        <tr><td style="padding:10px 40px 0;">
          <div style="display:inline-block;padding:6px 10px;border-radius:20px;background:#eaf7f4;color:#17725f;font-size:12px;font-weight:700;">CUENTA CREADA</div>
          <h1 style="margin:18px 0 10px;font-size:27px;line-height:34px;color:#10243d;">Bienvenido, {{ recipient_name }}</h1>
          {% if auth_method == 'local' %}
          <p style="margin:0 0 20px;font-size:16px;line-height:25px;color:#455565;">Tu cuenta fue creada correctamente. Ya podés entrar con el usuario <strong>{{ username }}</strong> y la contraseña temporal que te compartió {{ created_by }} por fuera de este correo — te la va a pedir cambiar apenas entres.</p>
          {% else %}
          <p style="margin:0 0 20px;font-size:16px;line-height:25px;color:#455565;">Tu cuenta fue creada correctamente. Ya podés entrar con tu cuenta de Microsoft desde MailingAI.</p>
          {% endif %}
        </td></tr>
        <tr><td style="padding:0 40px 8px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f5f8fa;border:1px solid #dce5eb;border-radius:8px;">
            <tr><td style="padding:18px 20px;font-size:14px;line-height:22px;color:#455565;">
              <strong style="color:#10243d;">Cuenta</strong><br>{{ recipient_email }}<br><br>
              {% if auth_method == 'local' %}<strong style="color:#10243d;">Usuario de acceso</strong><br>{{ username }}<br><br>{% endif %}
              <strong style="color:#10243d;">Perfil asignado</strong><br>{{ role_name }}<br><br>
              <strong style="color:#10243d;">Creada por</strong><br>{{ created_by }}
            </td></tr>
          </table>
        </td></tr>
        <tr><td align="center" style="padding:22px 40px 22px;">
          <table role="presentation" cellspacing="0" cellpadding="0"><tr><td bgcolor="#1f648f" style="border-radius:7px;">
            <a href="{{ app_url }}" style="display:inline-block;padding:14px 26px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:700;">Abrir MailingAI</a>
          </td></tr></table>
        </td></tr>
        <tr><td style="padding:20px 40px;background:#f7f9fb;border-top:1px solid #e1e7ec;font-size:12px;line-height:19px;color:#71808f;">
          Si no esperabas esta cuenta, avisale a {{ created_by }}.<br><br>
          Mensaje automático. No respondas a este correo.<br>
          © {{ current_year }} MailingAI
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
