    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO mailing.messages (message_id, run_id, conversation_id, internet_message_id, subject, from_address, from_name, to_addresses, cc_addresses, sent_datetime, received_datetime, has_attachments, importance, is_sent, categories, body_preview, body_content, web_link, folder_id, mailbox_account_id, raw_record, body_content_type) VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb, $9::jsonb, $10, $11, $12, $13, $14, $15::jsonb, $16, $17, $18, (SELECT folder_id FROM mailing.mail_folders WHERE folder_id = $19), $20, $21::jsonb, $22) ON CONFLICT (message_id) DO UPDATE SET run_id = EXCLUDED.run_id, conversation_id = EXCLUDED.conversation_id, internet_message_id = EXCLUDED.internet_message_id, subject = EXCLUDED.subject, from_address = EXCLUDED.from_address, from_name = EXCLUDED.from_name, to_addresses = EXCLUDED.to_addresses, cc_addresses = EXCLUDED.cc_addresses, sent_datetime = EXCLUDED.sent_datetime, received_datetime = EXCLUDED.received_datetime, has_attachments = EXCLUDED.has_attachments, importance = EXCLUDED.importance, is_sent = EXCLUDED.is_sent, categories = EXCLUDED.categories, body_preview = EXCLUDED.body_preview, body_content = EXCLUDED.body_content, web_link = EXCLUDED.web_link, folder_id = COALESCE(EXCLUDED.folder_id, mailing.messages.folder_id), mailbox_account_id = EXCLUDED.mailbox_account_id, raw_record = EXCLUDED.raw_record, body_content_type = EXCLUDED.body_content_type, updated_at = now() RETURNING message_id;",
        "options": {
          "queryReplacement": "={{ [$json.message_id, $json.run_id, $json.conversation_id, $json.internet_message_id, $json.subject, $json.from_address, $json.from_name, $json.to_addresses, $json.cc_addresses, $json.sent_datetime, $json.received_datetime, $json.has_attachments, $json.importance, $json.is_sent, $json.categories, $json.body_preview, $json.body_content, $json.web_link, $json.folder_id, $json.mailbox_account_id, $json.raw_record, $json.body_content_type] }}"
        }
      },
