      "id": "11111111-1111-4111-8111-111111111107",
      "name": "Return Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2000,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-matches-query",
              "leftValue": "={{ (() => {\n  const raw = ($('When Executed by Another Workflow').item.json.search || '').trim();\n  if (!raw) return true;\n  const haystack = (($json.subject || '') + ' ' + ($json.body?.content || '') + ' ' + ($json.bodyPreview || '')).toLowerCase();\n  const terms = raw.split(/\\s+/).filter(t => t.length > 0);\n  for (const term of terms) {\n    if (term.startsWith('-') && term.length > 1) {\n      const needle = term.slice(1).replace(/^%|%$/g, '').toLowerCase();\n      if (needle && haystack.includes(needle)) return false;\n    } else {\n      const needle = term.replace(/^%|%$/g, '').toLowerCase();\n      if (needle && !haystack.includes(needle)) return false;\n    }\n  }\n  return true;\n})() }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "77777777-7777-4777-8777-777777777719",
      "name": "Filter: Coincide Busqueda",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "alwaysOutputData": true,
      "position": [
        750,
        0
