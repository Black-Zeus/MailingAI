    {
      "parameters": {
        "fileName": "=/files/mailingai/out/histogram-{{ $now.toFormat('yyyyLLdd-HHmmss') }}.png",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "55555555-5555-4555-8555-555555555514",
      "name": "Write: Histogram PNG",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        1750,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO mailing.chart_runs (chart_type, params, output_file) VALUES ('histogram', $1::jsonb, $2) RETURNING chart_id;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify({ date_from: $('Set: Parametros').item.json.date_from, date_to: $('Set: Parametros').item.json.date_to, mailbox_account_id: $('Set: Parametros').item.json.mailbox_account_id }), $('Write: Histogram PNG').item.json.fileName] }}"
        }
      },
      "id": "55555555-5555-4555-8555-555555555515",
      "name": "Postgres: Insert chart_runs (histogram)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2000,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "cred0001postgres000",
          "name": "MailingAI Postgres"
        }
      }
    }
